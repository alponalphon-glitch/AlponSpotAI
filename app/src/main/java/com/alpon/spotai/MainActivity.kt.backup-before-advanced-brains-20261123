        if(marketType=="FOREX"){
            historyExhausted=true
            fullHistoryError="The selected Forex provider request already loaded up to 1,000 candles. Older pagination is not enabled in this build."
            return
        }
        if(marketType=="FUTURES"){
            historyExhausted=true
            fullHistoryError="Futures chart currently loads up to 1,000 latest candles. Older Futures pagination is not enabled yet."
            return
        }
        val requestedSymbol=symbol
        val requestedInterval=interval
        val oldestTime=candles.first().time

        viewModelScope.launch {
            historyLoading=true
            try {
                val page=repo.candlesBefore(
                    requestedSymbol,
                    requestedInterval,
                    oldestTime-1L,
                    1000
                )

                if (page.isNotEmpty()) {
                    withContext(Dispatchers.IO) {
                        candleDao.insertAll(
                            page.map { it.toEntity(requestedSymbol, requestedInterval) }
