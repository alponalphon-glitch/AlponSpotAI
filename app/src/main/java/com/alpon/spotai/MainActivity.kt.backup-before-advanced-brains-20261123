            Text(
                price?.let{"${fmt(it)} USDT"} ?: "Waiting for live price...",
                color=Color.White,fontSize=25.sp,fontWeight=FontWeight.Bold
            )
            Text("Selected pair: ${vm.symbol}",color=Muted,fontSize=11.sp)
            Spacer(Modifier.height(12.dp))
            OutlinedTextField(
                value=amount,
                onValueChange={amount=it},
                modifier=Modifier.fillMaxWidth(),
                singleLine=true,
                label={Text("Buy amount (USDT)")},
                keyboardOptions=KeyboardOptions(keyboardType=KeyboardType.Decimal)
            )
            Spacer(Modifier.height(10.dp))
            Button(
                onClick={vm.paperBuy(vm.symbol,price ?: 0.0,amount.toDoubleOrNull() ?: 0.0)},
                enabled=price!=null && price>0 && position==null,
                modifier=Modifier.fillMaxWidth()
            ) {
                Text("PAPER BUY")
            }
            if(position!=null) {
                Button(
                    onClick={vm.paperSell(vm.symbol,price ?: 0.0)},
                    enabled=price!=null && price>0,
                    modifier=Modifier.fillMaxWidth()
                ) {
                    Text("PAPER SELL")
                }
            }
            vm.paperMessage?.let {
                Text(it,color=Cyan,fontSize=11.sp)
            }
            Text("Simulation only • 0.1% fee per side • No real funds used",color=Muted,fontSize=10.sp)
        }

        Section("OPEN POSITIONS","${vm.paperPositions.size}")
        CardBox {
            if(vm.paperPositions.isEmpty()) {
                Text("No open paper positions.",color=Muted,fontSize=12.sp)
            } else {
                vm.paperPositions.forEach { item ->
                    Column(Modifier.fillMaxWidth().padding(vertical=6.dp)) {
                        Text(item.symbol,color=Color.White,fontWeight=FontWeight.Bold)
                        Text("Quantity: ${fmt(item.quantity)}",color=Muted,fontSize=11.sp)
                        Text("Entry: ${fmt(item.entryPrice)} USDT",color=Muted,fontSize=11.sp)
                        Text("Invested: ${fmt(item.invested)} USDT",color=Muted,fontSize=11.sp)
                        if(item.symbol==vm.symbol && unrealized!=null) {
                            Text(
                                "Estimated PnL: ${fmt(unrealized)} USDT",
                                color=if(unrealized>=0) Green else Red,
                                fontWeight=FontWeight.Bold,fontSize=12.sp
                            )
                        }
                    }
                    HorizontalDivider(color=Muted.copy(alpha=.2f))
                }
            }
        }

        Section("TRADE HISTORY","${vm.paperTrades.size} CLOSED")
        CardBox {
            if(vm.paperTrades.isEmpty()) {
                Text("Completed paper trades will appear here.",color=Muted,fontSize=12.sp)
            } else {
                vm.paperTrades.takeLast(20).asReversed().forEach { trade ->
                    Column(Modifier.fillMaxWidth().padding(vertical=7.dp)) {
                        Row(Modifier.fillMaxWidth(),horizontalArrangement=Arrangement.SpaceBetween) {
                            Text(trade.symbol,color=Color.White,fontWeight=FontWeight.Bold,fontSize=12.sp)
                            Text(
                                "${if(trade.pnl>=0) "+" else ""}${fmt(trade.pnl)} USDT",
                                color=if(trade.pnl>=0) Green else Red,fontSize=12.sp
                            )
                        }
                        Text(
                            "Entry ${fmt(trade.entryPrice)} → Exit ${fmt(trade.exitPrice)}",
                            color=Muted,fontSize=10.sp
                        )
                    }
                    HorizontalDivider(color=Muted.copy(alpha=.15f))
                }
            }
        }
    }
}
