    private suspend fun loadForexMarket(requestedSymbol:String, requestedInterval:String){
        val key=forexApiKey
        if(key.isBlank()){
            ticker=null;candles=emptyList();signal=null;marketStructure=null;multiTimeframeSignal=null;priceActionReport=null;smartMoneyReport=null;aiAnalysisReport=null;decisionReport=null
            error="Forex data needs your Twelve Data API key. Tap FOREX and add the key from your Twelve Data account."
            multiTimeframeError="Forex history and analysis are locked until a valid provider key is entered."
            return
        }
        val pair=if(requestedSymbol.startsWith("FX_") && requestedSymbol.length==9) requestedSymbol.substring(3,6)+"/"+requestedSymbol.substring(6,9) else "EUR/USD"
        val frameSpecs=listOf("1M" to ("1month" to 240),"1W" to ("1week" to 500),"1D" to ("1day" to 1000),"4H" to ("4h" to 300),"2H" to ("2h" to 300),"1H" to ("1h" to 300),"15M" to ("15min" to 300))
        val frameData=withContext(Dispatchers.IO){
