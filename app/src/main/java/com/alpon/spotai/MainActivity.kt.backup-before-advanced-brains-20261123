    private fun refreshExternalMarketContext(force:Boolean=false) {
        if (externalContextLoading) return
        val now=System.currentTimeMillis()
        if (!force && externalMarketContext?.symbol==symbol.removeSuffix("USDT").removeSuffix("USDC").removeSuffix("BUSD").removeSuffix("USD").removeSuffix("PERP") && now-externalContextAttemptAt<15L*60L*1000L) return
        externalContextAttemptAt=now
        val requested=symbol
        externalContextLoading=true
        viewModelScope.launch {
            try {
                val result=externalContextRepo.load(requested)
                if(requested==symbol) { externalMarketContext=result; updateAiAnalysis() }
            } catch(_:Exception) {
                if(requested==symbol) externalMarketContext=null
            } finally { externalContextLoading=false }
        }
    }

    private fun updateAiAnalysis() {
        refreshExternalMarketContext()
        marketRegime = MarketRegimeAnalysis.analyze(candles)
        smartMoneyReport = SmartMoneyAnalysis.analyze(candles, marketStructure)
        technicalEnsembleReport = TechnicalEnsembleEngine.analyze(candles)
        val base = AIAnalysisEngine.analyze(
            signal, multiTimeframeSignal, marketStructure, marketRegime, priceActionReport, smartMoneyReport, technicalEnsembleReport
        )
        val learning = AdaptiveLearningEngine.evaluate(
            marketRegime?.regime ?: "UNKNOWN",
            AdaptiveLearningEngine.decode(paperPrefs.getString("adaptive_outcomes", null))
        )
        aiAnalysisReport = if (base == null) null else if (base.action == "BUY" && !learning.allowed) {
            val previousGate = base.qualityGate
            val gate = previousGate?.copy(
                allowed = false,
                action = "WAIT",
                blockers = previousGate.blockers + learning.explanation
            )
            base.copy(action = "WAIT", warnings = base.warnings + learning.explanation, qualityGate = gate)
        } else {
            base.copy(warnings = base.warnings + learning.explanation)
        }
        val paperEquity = paperBalance + paperPositions.sumOf { it.invested }
        val paperGuard = paperLossGuard.canOpenNewPosition(paperEquity, System.currentTimeMillis())
        paperPrefs.edit().putString("loss_guard", paperLossGuard.snapshot()).apply()
        cognitiveReport = CognitiveIntelligenceEngine.analyze(
            candles = candles,
            regime = marketRegime,
            structure = marketStructure,
            smartMoney = smartMoneyReport,
            signal = signal,
            ai = aiAnalysisReport,
            outcomes = AdaptiveLearningEngine.decode(paperPrefs.getString("adaptive_outcomes", null)),
            lossGuardAllowed = paperGuard.first,
            lossGuardReason = paperGuard.second,
            adaptiveRiskMultiplier = learning.riskMultiplier
        )
        decisionReport = DecisionIntelligenceEngine.evaluate(
            candles = candles,
            interval = interval,
            technical = signal,
            mtf = multiTimeframeSignal,
            structure = marketStructure,
            regime = marketRegime,
            priceAction = priceActionReport,
            smartMoney = smartMoneyReport,
            ai = aiAnalysisReport,
            walkForward = walkForwardResult,
            ticker = ticker,
            symbol = symbol,
            hasSpotHolding = paperPositions.any { it.symbol == symbol && it.quantity > 0.0 },
            lossGuardAllowed = paperGuard.first,
            lossGuardReason = paperGuard.second,
            externalContext = externalMarketContext,
            cognitive = cognitiveReport,
            derivatives = futuresDerivativesReport,
            ensemble = technicalEnsembleReport,
            learning = learning
        )
        val mustWait = aiAnalysisReport?.action == "BUY" && decisionReport?.allowed != true ||
            aiAnalysisReport?.action == "SELL" && decisionReport?.action != "SELL"
        if (mustWait) {
            val previous = aiAnalysisReport
            if (previous != null) {
                val blockers = decisionReport?.blockers.orEmpty()
                val previousGate = previous.qualityGate
                val gate = previousGate?.copy(
                    allowed = false,
                    action = "WAIT",
                    blockers = (previousGate.blockers + blockers).distinct()
                )
                aiAnalysisReport = previous.copy(
                    action = "WAIT",
                    warnings = (previous.warnings + blockers).distinct(),
                    qualityGate = gate
                )
            }
        }
        if (marketType == "FUTURES") {
            val previous = aiAnalysisReport
            if (previous != null) {
                val derivatives = futuresDerivativesReport
                val futuresBlockers = buildList {
                    if (derivatives == null || !derivatives.available) add("Futures derivatives analysis is unavailable; funding, positioning and taker flow must be checked.")
                    else addAll(derivatives.blockers)
                    add("Execution remains disabled until leverage, isolated/cross margin, position size and liquidation-distance controls are explicitly configured.")
                }
                val futuresGate = previous.qualityGate
                aiAnalysisReport = previous.copy(
                    action = "WAIT",
                    warnings = (previous.warnings + futuresBlockers + derivatives?.observations.orEmpty()).distinct(),
                    qualityGate = futuresGate?.copy(
                        allowed = false,
                        action = "WAIT",
                        blockers = (futuresGate.blockers + futuresBlockers).distinct()
                    )
                )
            }
        }
    }

    fun runBacktest(initialCapital: Double = 1000.0, riskPercent: Double = 0.5) {
        if (backtestLoading) return
        val requestedSymbol = symbol
        val requestedInterval = interval

        viewModelScope.launch {
            backtestLoading = true
            backtestError = null
            backtestResult = null
            try {
                val historyInfo = withContext(Dispatchers.IO) {
                    Pair(
                        candleDao.getEarliestTime(requestedSymbol, requestedInterval),
                        candleDao.countCandles(requestedSymbol, requestedInterval)
                    )
                }
                val firstTime = historyInfo.first
                val storedCount = historyInfo.second

                if (firstTime == null || storedCount < 211) {
                    if (requestedSymbol == symbol && requestedInterval == interval) {
                        backtestError = "Not enough saved candles. Download Binance history for this coin and timeframe first."
                    }
                    return@launch
                }

                // Room pages are streamed directly into the engine. The full history is never
                // collected into an ArrayList, so RAM usage stays bounded as history grows.
                val result = withContext(Dispatchers.Default) {
                    BacktestingEngine.runFromPages(
                        firstTime = firstTime,
                        interval = requestedInterval,
                        initialCapital = initialCapital,
                        riskPercent = riskPercent
                    ) { afterTime, limit ->
                        candleDao.getCandlesAfter(
                            requestedSymbol,
                            requestedInterval,
                            afterTime,
                            limit
                        ).map { it.toCandle() }
                    }
                }

                if (requestedSymbol == symbol && requestedInterval == interval) {
                    backtestResult = result
                    if (result == null) {
                        backtestError = "Not enough valid Binance candle history for backtesting."
                    }
                }
            } catch (e: Exception) {
                if (requestedSymbol == symbol && requestedInterval == interval) {
                    backtestError = e.message ?: "Backtesting failed."
                }
            } finally {
                backtestLoading = false
            }
        }
    }

    fun runWalkForward(initialCapital: Double = 1000.0, riskPercent: Double = 0.5) {
        if (walkForwardLoading) return
        val requestedSymbol = symbol
        val requestedInterval = interval
        viewModelScope.launch {
            walkForwardLoading = true
            walkForwardError = null
            walkForwardResult = null
            updateAiAnalysis()
            try {
                val bounds = withContext(Dispatchers.IO) {
                    Pair(
                        candleDao.getEarliestTime(requestedSymbol, requestedInterval),
                        candleDao.getLatestTime(requestedSymbol, requestedInterval)
                    )
                }
                val first = bounds.first
                val last = bounds.second
                if (first == null || last == null || last <= first) {
                    if (requestedSymbol == symbol && requestedInterval == interval) {
                        walkForwardError = "Not enough saved history. Download more Binance candles first."
                    }
                    return@launch
                }

                val result = withContext(Dispatchers.Default) {
                    WalkForwardEngine.run(
                        firstTime = first,
                        lastTime = last,
                        interval = requestedInterval,
                        initialCapital = initialCapital,
                        riskPercent = riskPercent
                    ) { afterTime, untilTime, limit ->
                        candleDao.getCandlesAfterUntil(
                            requestedSymbol, requestedInterval, afterTime, untilTime, limit
                        ).map { it.toCandle() }
                    }
                }
                if (requestedSymbol == symbol && requestedInterval == interval) {
                    walkForwardResult = result
                    if (result == null) walkForwardError = "History is too short for chronological walk-forward testing."
                    updateAiAnalysis()
                }
            } catch (e: Exception) {
                if (requestedSymbol == symbol && requestedInterval == interval) {
                    walkForwardError = e.message ?: "Walk-forward validation failed."
                }
            } finally {
                walkForwardLoading = false
            }
        }
    }

