    private fun connectLiveStream(generation:Int){
        val streamSymbol=symbol.lowercase(Locale.US)
        val streamInterval=interval
        liveStatus="CONNECTING"
        val request=Request.Builder().url("wss://stream.binance.com:9443/stream?streams=${streamSymbol}@kline_${streamInterval}/${streamSymbol}@trade").build()
        liveSocket=liveClient.newWebSocket(request,object:WebSocketListener(){
            override fun onOpen(webSocket:WebSocket,response:Response){if(generation==liveGeneration)liveStatus="LIVE" else webSocket.close(1000,"Stale stream")}
            override fun onMessage(webSocket:WebSocket,text:String){
                if(generation!=liveGeneration)return
                runCatching {
                    val envelope=JSONObject(text);val root=envelope.optJSONObject("data") ?: envelope
                    if(root.optString("e")=="trade"){
                        val price=root.getString("p").toDouble();val old=candles
                        if(old.isNotEmpty()){
                            val last=old.last();val live=last.copy(high=maxOf(last.high,price),low=minOf(last.low,price),close=price)
                            candles=old.dropLast(1)+live
                        }
                        ticker=ticker?.copy(lastPrice=root.getString("p"))
                        viewModelScope.launch(Dispatchers.Main.immediate) { managePaperPositionTick(price) }
                    } else if(root.optString("e")=="kline"){
                        val k=root.getJSONObject("k")
                        val candle=Candle(
                            time=k.getLong("t"),
                            open=k.getString("o").toDouble(),
                            high=k.getString("h").toDouble(),
                            low=k.getString("l").toDouble(),
                            close=k.getString("c").toDouble(),
                            volume=k.getString("v").toDouble(),
                            closeTime=k.optLong("T"),
                            quoteVolume=k.optString("q","0").toDoubleOrNull() ?: 0.0,
                            tradeCount=k.optLong("n"),
                            takerBuyBaseVolume=k.optString("V","0").toDoubleOrNull() ?: 0.0,
                            takerBuyQuoteVolume=k.optString("Q","0").toDoubleOrNull() ?: 0.0
                        )
                        val old=candles
                        candles=if(old.lastOrNull()?.time==candle.time) old.dropLast(1)+candle else if(old.any{it.time==candle.time}) old.map{if(it.time==candle.time)candle else it} else (old+candle)
                        ticker=ticker?.copy(lastPrice=k.getString("c"))
                        if(k.optBoolean("x",false)){
                            signal=TechnicalAnalysis.analyze(candles,streamInterval)
                            marketStructure=MarketStructureAnalysis.analyze(candles)
                            updateAiAnalysis()
                        }
                    }
                }
            }
            override fun onFailure(webSocket:WebSocket,t:Throwable,response:Response?){
                if(generation==liveGeneration){liveStatus="RECONNECTING";viewModelScope.launch{delay(3000);if(generation==liveGeneration)connectLiveStream(generation)}}
            }
            override fun onClosed(webSocket:WebSocket,code:Int,reason:String){if(generation==liveGeneration)liveStatus="DISCONNECTED"}
        })
    }
