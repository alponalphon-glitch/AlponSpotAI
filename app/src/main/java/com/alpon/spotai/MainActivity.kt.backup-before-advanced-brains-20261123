    fun paperBuy(s:String,price:Double,amount:Double) {
        paperMessage=null
        val aiGate=aiAnalysisReport?.qualityGate
        if(aiAnalysisReport?.action!="BUY" || aiGate?.allowed!=true || decisionReport?.allowed!=true) {
            val reasons = decisionReport?.blockers?.take(3)?.joinToString(" ")
            paperMessage = "NEXORA Decision Gate: BUY blocked. ${reasons ?: "Wait for complete data, analyst agreement and Walk-Forward validation."}"
            return
        }
        val equity=paperBalance+paperPositions.sumOf { it.invested }
        val guard=paperLossGuard.canOpenNewPosition(equity,System.currentTimeMillis())
        if(!guard.first) {
            paperMessage=guard.second
            return
        }
        val adaptive = AdaptiveLearningEngine.evaluate(
            marketRegime?.regime ?: "UNKNOWN",
            AdaptiveLearningEngine.decode(paperPrefs.getString("adaptive_outcomes", null))
        )
        if (!adaptive.allowed) {
            paperMessage = adaptive.explanation
            return
        }
        val adaptiveCap = equity * 0.25 * adaptive.riskMultiplier
        if(amount>adaptiveCap) {
            paperMessage="Adaptive capital protection: current regime caps this position at ${fmt(adaptiveCap)} USDT. ${adaptive.explanation}"
            return
        }
        if(s.isBlank() || !price.isFinite() || price<=0 ||
            !amount.isFinite() || amount<=0 ||
            !paperBalance.isFinite() || paperBalance<0) {
            paperMessage="Invalid market price, amount, or virtual balance."
            return
        }
        if(paperPositions.any{it.symbol==s}) {
            paperMessage="A Paper Trading position for $s is already open."
            return
        }
        val fee=amount*0.001
        val total=amount+fee
        val quantity=amount/price
        if(!fee.isFinite() || !total.isFinite() ||
            !quantity.isFinite() || quantity<=0) {
            paperMessage="Trade calculation is outside the supported numeric range."
            return
        }
        if(total>paperBalance) {
            paperMessage="Insufficient virtual balance, including the 0.1% fee."
            return
        }
        val newBalance=paperBalance-total
        if(!newBalance.isFinite() || newBalance<0) {
            paperMessage="Unable to safely calculate the remaining balance."
            return
        }
        paperBalance=newBalance
        val entryAtr = signal?.atr?.takeIf { it.isFinite() && it > 0.0 } ?: price * 0.02
        val initialStop = (price - entryAtr * 1.8).coerceAtLeast(price * 0.5)
        paperPositions=paperPositions+PaperPosition(
            s,quantity,price,total,System.currentTimeMillis(),marketRegime?.regime ?: "UNKNOWN",
            initialStop,initialStop,price,entryAtr,false
        )
        paperPrefs.edit().putString("loss_guard",paperLossGuard.snapshot()).apply()
        persistPaperTrading()
        updateAiAnalysis()
        paperMessage="Paper BUY executed: $s at ${fmt(price)}."
    }

    private fun managePaperPositionTick(price:Double) {
        if (marketType != "BINANCE_SPOT" || !price.isFinite() || price <= 0.0) return
        val position = paperPositions.firstOrNull { it.symbol == symbol } ?: return
        val atrNow = signal?.atr?.takeIf { it.isFinite() && it > 0.0 }
            ?: position.atrAtEntry.takeIf { it.isFinite() && it > 0.0 }
            ?: position.entryPrice * 0.02
        val state = DynamicTradeState(
            position.entryPrice, position.atrAtEntry.takeIf { it > 0.0 } ?: atrNow,
            position.peakPrice.takeIf { it > 0.0 } ?: position.entryPrice,
            position.trailingStop.takeIf { it > 0.0 } ?: position.initialStop.takeIf { it > 0.0 } ?: (position.entryPrice - atrNow * 1.8),
            position.trailingActive
        )
        val opposing = signal?.action == "SELL"
        val update = DynamicTradeManager.updateLong(state, price, atrNow, opposing, signal?.score ?: 0) ?: return
        val changed = position.copy(
            peakPrice = update.state.peakPrice, trailingStop = update.state.stopPrice,
            trailingActive = update.state.trailingActive
        )
        if (changed != position) {
            paperPositions = paperPositions.map { if (it.symbol == position.symbol) changed else it }
            persistPaperTrading()
        }
        if (update.shouldExit && paperPositions.any { it.symbol == position.symbol }) {
            paperMessage = "NEXORA DYNAMIC EXIT: ${update.exitReason}"
            paperSell(position.symbol, price)
            paperMessage = "NEXORA DYNAMIC EXIT • ${update.exitReason} • ${paperMessage.orEmpty()}"
        }
    }

    fun paperSell(s:String,price:Double,requestedQuantity:Double?=null) {
        paperMessage=null
        val position=paperPositions.firstOrNull{it.symbol==s}
        if(position==null) {
            paperMessage="No open Paper Trading position for $s. Spot SELL cannot open a short position."
            return
        }
        val sellQuantity=requestedQuantity ?: position.quantity
        if(!price.isFinite() || price<=0 ||
            !position.quantity.isFinite() || position.quantity<=0 ||
            !position.entryPrice.isFinite() || position.entryPrice<=0 ||
            !position.invested.isFinite() || position.invested<=0 ||
            !sellQuantity.isFinite() || sellQuantity<=0 || sellQuantity>position.quantity+1e-12) {
            paperMessage="Invalid SELL quantity or position data. Spot SELL cannot exceed available holdings."
            return
        }
        val safeQuantity=minOf(sellQuantity,position.quantity)
        val allocatedCost=position.invested*(safeQuantity/position.quantity)
        val gross=safeQuantity*price
        val fee=gross*0.001
        val net=gross-fee
        val pnl=net-allocatedCost
        val newBalance=paperBalance+net
        val remainingQuantity=(position.quantity-safeQuantity).coerceAtLeast(0.0)
        val remainingInvested=(position.invested-allocatedCost).coerceAtLeast(0.0)
        if(!allocatedCost.isFinite() || allocatedCost<=0 || !gross.isFinite() || gross<=0 || !fee.isFinite() ||
            !net.isFinite() || net<=0 || !pnl.isFinite() || !newBalance.isFinite() || newBalance<0 ||
            !remainingQuantity.isFinite() || !remainingInvested.isFinite()) {
            paperMessage="Trade calculation is outside the supported numeric range."
            return
        }
        paperBalance=newBalance
        val isFullExit=remainingQuantity<=maxOf(position.quantity*1e-10,1e-12)
        paperPositions=if(isFullExit) paperPositions.filterNot{it.symbol==s} else paperPositions.map {
            if(it.symbol==s) it.copy(quantity=remainingQuantity,invested=remainingInvested) else it
        }
        val equityAfter=newBalance+paperPositions.sumOf { it.invested }
        paperLossGuard.recordClosedTrade(pnl,equityAfter,System.currentTimeMillis())
        paperPrefs.edit().putString("loss_guard",paperLossGuard.snapshot()).apply()
        val exitTime = System.currentTimeMillis()
        paperTrades=(paperTrades+PaperTrade(
            s,safeQuantity,position.entryPrice,price,pnl,exitTime,position.entryTime
        )).takeLast(200)
        val priorLearning = AdaptiveLearningEngine.decode(paperPrefs.getString("adaptive_outcomes", null))
        val outcome = AdaptiveTradeOutcome(
            position.entryRegime,
            if (allocatedCost > 0.0) pnl / allocatedCost * 100.0 else 0.0,
            exitTime
        )
        paperPrefs.edit().putString(
            "adaptive_outcomes",
            AdaptiveLearningEngine.encode((priorLearning + outcome).takeLast(100))
        ).apply()
        persistPaperTrading()
        updateAiAnalysis()
        paperMessage="Paper SELL executed: $s • ${fmt(safeQuantity)} units • PnL ${fmt(pnl)} USDT • ${if(isFullExit) "position closed" else "partial exit; remaining ${fmt(remainingQuantity)}"}."
    }
}
