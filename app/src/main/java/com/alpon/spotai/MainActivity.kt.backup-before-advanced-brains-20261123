@Composable
fun AIEngineCard(vm: SpotViewModel) {
    val report = vm.aiAnalysisReport

    Section("AI DECISION ENGINE", if(vm.marketType=="FOREX")"Forex • 7 timeframes • Structure" else "Indicators • Price Action • 12 timeframes • Structure")
    CardBox {
        if (report == null) {
            Text(
                "Waiting for complete market analysis...",
                color = Muted,
                fontSize = 12.sp
            )
            if (vm.loading) {
                LinearProgressIndicator(
                    Modifier.fillMaxWidth(),
                    color = Cyan
                )
            }
        } else {
            val actionColor = when (report.action) {
                "BUY" -> Green
                "SELL" -> Red
                else -> Cyan
            }

            Row(
                Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Column {
                    Text(
                        "AI CONSENSUS",
                        color = Muted,
                        fontSize = 10.sp
                    )
                    Text(
                        report.action,
                        color = actionColor,
                        fontSize = 29.sp,
                        fontWeight = FontWeight.ExtraBold
                    )
                }
                Column(horizontalAlignment = Alignment.End) {
                    Text("CONFIDENCE", color = Muted, fontSize = 10.sp)
                    Text(
                        "${report.confidence}%",
                        color = Color.White,
                        fontSize = 23.sp,
                        fontWeight = FontWeight.Bold
                    )
                }
            }

            Spacer(Modifier.height(12.dp))

            Row(
                Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween
            ) {
                Metric(
                    "Directional score",
                    "%+.1f".format(report.directionalScore)
                )
                Metric(
                    "Agreement",
                    "${report.agreement}/${report.components.count { kotlin.math.abs(it.score) >= 15.0 }}"
                )
            }

            Spacer(Modifier.height(12.dp))

            report.qualityGate?.let { gate ->
                CardBox {
                    Text("AI TRADE QUALITY GATE",color=Cyan,fontSize=11.sp,fontWeight=FontWeight.Bold)
                    Text(if(gate.allowed) "ENTRY CHECKS PASSED" else "ENTRY BLOCKED — WAIT",color=if(gate.allowed) Green else Red,fontSize=15.sp,fontWeight=FontWeight.ExtraBold)
                    Text("Quality checks: ${gate.qualityScore}/100",color=Muted,fontSize=10.sp)
                    gate.blockers.forEach { Text("• $it",color=Red,fontSize=10.sp) }
                    gate.checks.forEach { Text("• $it",color=Green,fontSize=10.sp) }
                }
            }

            val regime = vm.marketRegime
            if (regime != null) {
                CardBox {
                    Text(
                        "MARKET REGIME",
                        color = Cyan,
                        fontSize = 11.sp,
                        fontWeight = FontWeight.Bold
                    )
                    Text(
                        regime.regime,
                        color = when (regime.regime) {
                            "HIGH VOLATILITY" -> Red
                            "TRENDING" -> Green
                            else -> Cyan
                        },
                        fontSize = 19.sp,
                        fontWeight = FontWeight.ExtraBold
                    )
                    Text(
                        "Trend: ${regime.trend}  •  Volatility: ${regime.volatility}",
                        color = Muted,
                        fontSize = 11.sp
                    )
                    Spacer(Modifier.height(8.dp))
                    Row(
                        Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceBetween
                    ) {
                        Metric("ATR", "%.2f%%".format(regime.atrPercent))
                        Metric("Volatility ratio", "%.2fx".format(regime.volatilityRatio))
                        Metric("Efficiency", "%.2f".format(regime.efficiencyRatio))
                    }
                    Text(
                        "ADX (Wilder 14): %.1f  •  Trend strength: %s".format(
                            regime.adx, regime.trendStrength
                        ),
                        color = when (regime.trendStrength) {
                            "STRONG", "VERY STRONG" -> Green
                            "DEVELOPING" -> Cyan
                            "WEAK" -> Muted
                            else -> Red
                        },
                        fontSize = 10.sp
                    )
                    Text(
                        "Heuristic confidence: %d%%".format(regime.confidence),
                        color = Muted,
                        fontSize = 10.sp,
                        modifier = Modifier.padding(top = 8.dp)
                    )
                    Text(
                        regime.explanation,
                        color = Muted,
                        fontSize = 11.sp,
                        modifier = Modifier.padding(top = 5.dp)
                    )
                }
            } else {
                Text("Market Regime: waiting for enough closed candles", color = Muted, fontSize = 11.sp)
            }

            HorizontalDivider(color = Muted.copy(alpha = 0.2f))
            Text(
                "ANALYSIS COMPONENTS",
                color = Cyan,
                fontSize = 10.sp,
                fontWeight = FontWeight.Bold,
                modifier = Modifier.padding(top = 10.dp, bottom = 8.dp)
            )

            report.components.forEach { component ->
                val color = when {
                    component.score > 0 -> Green
                    component.score < 0 -> Red
                    else -> Muted
                }

                Row(
                    Modifier.fillMaxWidth().padding(vertical = 5.dp),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Column(Modifier.weight(1f)) {
                        Text(
                            component.name,
                            color = Color.White,
                            fontSize = 12.sp,
                            fontWeight = FontWeight.SemiBold
                        )
                        Text(
                            component.direction,
                            color = color,
                            fontSize = 9.sp
                        )
                    }
                    Text(
                        "%+.0f".format(component.score),
                        color = color,
                        fontSize = 13.sp,
                        fontWeight = FontWeight.Bold
                    )
                    Text(
                        "${(component.weight * 100).toInt()}%",
                        color = Muted,
                        fontSize = 10.sp,
                        modifier = Modifier.width(36.dp)
                    )
                }

                LinearProgressIndicator(
                    progress = { (kotlin.math.abs(component.score) / 100.0).toFloat() },
                    modifier = Modifier.fillMaxWidth().height(4.dp),
                    color = color,
                    trackColor = Muted.copy(alpha = 0.15f)
                )
            }

            if (report.reasons.isNotEmpty()) {
                Text(
                    "DECISION REASONS",
                    color = Cyan,
                    fontSize = 10.sp,
                    fontWeight = FontWeight.Bold,
                    modifier = Modifier.padding(top = 12.dp, bottom = 5.dp)
                )
                report.reasons.forEach {
                    Text("• $it", color = Muted, fontSize = 11.sp)
                }
            }

            if (report.warnings.isNotEmpty()) {
                Text(
                    "WARNINGS",
                    color = Red,
                    fontSize = 10.sp,
                    fontWeight = FontWeight.Bold,
                    modifier = Modifier.padding(top = 12.dp, bottom = 5.dp)
                )
                report.warnings.forEach {
                    Text("• $it", color = Red.copy(alpha = 0.85f), fontSize = 10.sp)
                }
            }
        }
    }
}


