private fun tr(key:String,language:String):String = when(key) { "News" -> newsTabLabels[language] ?: "News"; else -> extendedTranslations[language]?.get(key) ?: translations[language]?.get(key) ?: key }

@Composable fun SpotApp(vm:SpotViewModel= viewModel()) {
    val context= LocalContext.current
    val prefs= remember { context.getSharedPreferences("app_preferences",0) }
    var language by remember { mutableStateOf(prefs.getString("language","en") ?: "en") }
    var tab by remember { mutableStateOf("Home") }
    var menuOpen by remember { mutableStateOf(false) }
    var page by remember { mutableStateOf<String?>(null) }
    LaunchedEffect(Unit){vm.load();vm.loadMarkets()}
    // Binance WebSocket pushes the selected kline in real time; the REST snapshot seeds history.
    LaunchedEffect(tab,page,vm.symbol,vm.interval,vm.marketType) {
        if((page==null && (tab=="Home" || tab=="Scanner" || tab=="NEXORA")) || page=="Paper Trading") { vm.load(); vm.startLiveStream() }
        if(page==null && tab=="Markets") { if(vm.marketType=="FUTURES") vm.loadFuturesMarkets() else if(vm.marketType=="BINANCE_SPOT") vm.loadMarkets() }
        try { while(true) { if(page==null && tab=="Markets") { if(vm.marketType=="FUTURES") vm.loadFuturesMarkets() else if(vm.marketType=="BINANCE_SPOT") vm.loadMarkets() }; delay(60_000L) } }
        finally { vm.stopLiveStream() }
    }
    LaunchedEffect(tab,page,vm.symbol,vm.marketType) {
        if (page == null && (tab == "Home" || tab == "NEXORA")) {
            while (true) {
                delay(if(vm.marketType=="FOREX")30 * 60_000L else 5 * 60_000L)
                vm.refreshDeepAnalysis()
            }
        }
    }
    LaunchedEffect(tab,page,vm.scanInterval) {
        if (tab=="Scanner" && page==null) {
            while (true) { vm.scan(); delay(60_000L) }
        }
    }
    val nav=listOf("Home" to Icons.Default.ShowChart,"Markets" to Icons.Default.Explore,"NEXORA" to Icons.Default.Psychology,"Portfolio" to Icons.Default.AccountBalanceWallet,"Settings" to Icons.Default.Tune)
    Scaffold(containerColor=Bg,bottomBar={
        if(page==null) NavigationBar(containerColor=Color(0xFF07111F),contentColor=Muted,modifier=Modifier.heightIn(min=72.dp)) {
            nav.forEach{(name,icon)->
                val label=when(name){"Home"->tr("Home",language);"Portfolio"->tr("Portfolio",language);"NEXORA"->"NEXORA";else->tr(name,language)}
