package com.alpon.spotai.domain

/** Central control-plane registry and final fail-closed audit of existing NEXORA modules. */
data class MasterBrainSubsystem(
    val name: String,
    val status: String,
    val detail: String,
    val contributesToDecision: Boolean
)

data class MasterControlBrainReport(
    val title: String,
    val finalAction: String,
    val gateStatus: String,
    val connectedSubsystems: Int,
    val totalSubsystems: Int,
    val readinessPercent: Int,
    val systems: List<MasterBrainSubsystem>,
    val centralSummary: String,
    val finalBlockers: List<String>
)


object MasterControlBrainEngine {
    fun evaluate(
        proposedAction: String,
        allowed: Boolean,
        integrity: DataIntegrityReport,
        blockers: List<String>,
        unified: UnifiedBrainReport,
        advanced: CentralBrainAdvancedReport,
        strategic: CentralBrainStrategicReport,
        finalLayer: CentralBrainFinalReport,
        autonomous: AutonomousOrchestrationReport,
        cognitive: CognitiveExtensionReport,
        research: NexoraResearchReport,
        adaptive: NexoraAdaptiveReport,
        redTeam: RedTeamReport,
        scenarioRisk: ScenarioRiskReport,
        shock: MarketShockReport,
        technicalQuality: TechnicalQualityReport,
        derivatives: FuturesDerivativesReport?,
        external: com.alpon.spotai.data.ExternalMarketContext?,
        walkForward: WalkForwardResult?,
        globalResearch: GlobalAnalyticalCapabilitiesReport
    ): MasterControlBrainReport {
        val systems = mutableListOf(
            MasterBrainSubsystem("Market Data & Integrity", if (integrity.valid) "VERIFIED" else "BLOCKED", "${integrity.checkedCandles} closed candles; ${integrity.timeframeCount} timeframe feeds checked. ${integrity.reasons.take(2).joinToString()}", true),
            MasterBrainSubsystem("Technical / Indicator Analysis", if (technicalQuality.available) "AVAILABLE" else "UNAVAILABLE", "${technicalQuality.direction}; score ${technicalQuality.score}", true),
            MasterBrainSubsystem("Unified Evidence Brain", if (unified.evidenceCount >= 5) "CONNECTED" else "LIMITED", "${unified.evidenceCount} evidence sources; bias ${unified.direction}; ${unified.conflicts.size} conflict(s).", true),
            MasterBrainSubsystem("Advanced Cognitive Layer", "CONNECTED", "Regime transition ${advanced.regimeTransition}; uncertainty ${advanced.uncertainty}; adversarial ${advanced.adversarial}; counterfactual ${advanced.counterfactual}; calibration ${advanced.calibration}; drift ${advanced.modelDrift}.", true),
            MasterBrainSubsystem("Strategic Layer", "CONNECTED", "Liquidity ${strategic.liquidityIntelligence}; event context ${strategic.eventImpact}; execution ${strategic.executionReality}.", true),
            MasterBrainSubsystem("Research & Quant Lab", if (research.available) "ACTIVE" else "WARM-UP", research.note, true),
            MasterBrainSubsystem("Adaptive Learning", if (adaptive.deepLearning.acceptedAsEvidence || adaptive.reinforcementLearning.acceptedAsEvidence || adaptive.strategyEvolution.promotedToShadow) "SHADOW EVIDENCE" else "WARM-UP / SHADOW", adaptive.note, true),
            MasterBrainSubsystem("Analyst Council", if (unified.conflicts.isEmpty()) "NO CENTRAL CONFLICT FLAG" else "CONFLICT DETECTED", "Reuses current independent rule-based analyst outputs; no separate AI agents are implied.", true),
            MasterBrainSubsystem("Red Team / Skeptic", if (redTeam.robust) "PASSED COUNTERCHECK" else "COUNTER-EVIDENCE", redTeam.counterArguments.take(3).joinToString().ifBlank { "No counterarguments supplied." }, true),
            MasterBrainSubsystem("Scenario & Stress Risk", if (scenarioRisk.sufficientHistory) "STRESS EVIDENCE" else "INSUFFICIENT HISTORY", "Stop covers historical stress ${scenarioRisk.stopCoversHistoricalStress}; historical stress sufficiency ${scenarioRisk.sufficientHistory}.", true),
            MasterBrainSubsystem("Market Shock Circuit Breaker", if (shock.safeForNewEntry) "CLEAR" else "GUARD ACTIVE", shock.findings.take(3).joinToString().ifBlank { "No shock guard finding." }, true),
            MasterBrainSubsystem("Derivatives Context", if (derivatives?.available == true && derivatives.blockers.isEmpty()) "AVAILABLE" else "UNAVAILABLE / GUARDED", derivatives?.directionalBias ?: "No derivatives report provided.", false),
            MasterBrainSubsystem("External Market / News Context", if (external?.verificationReady == true) "VERIFIED" else "UNVERIFIED / MISSING", "External context is only admitted when source verification passes.", false),
            MasterBrainSubsystem("Walk-Forward Validation", if (walkForward != null) "RESULT PRESENT" else "NOT RUN", LearningValidationEngine.assess(walkForward).status, true),
            MasterBrainSubsystem("Decision Trace / Snapshot Monitor", "CONNECTED", finalLayer.decisionTrace + " • " + finalLayer.liveMonitor, true),
            MasterBrainSubsystem("Autonomous Orchestration", "CONNECTED / PAPER-FIRST", "${autonomous.readyModules}/${autonomous.totalModules} ready in orchestration; paper-first only.", true),
            MasterBrainSubsystem("Portfolio Intelligence", "NOT CONNECTED", "No portfolio-wide position/correlation exposure object is supplied to this decision pipeline.", false),
            MasterBrainSubsystem("Execution Reality", "PARTIAL PROXY", strategic.executionDetail, false),
            MasterBrainSubsystem("Global Causality / Association", globalResearch.causality, globalResearch.causalityDetail, false),
            MasterBrainSubsystem("Predictive Horizon Matrix", globalResearch.horizonMatrix, globalResearch.horizonDetail, false),
            MasterBrainSubsystem("Hidden Pattern Discovery", globalResearch.hiddenPatterns, globalResearch.hiddenPatternDetail, false),
            MasterBrainSubsystem("Cross-Asset Contagion", globalResearch.contagion, globalResearch.contagionDetail, false),
            MasterBrainSubsystem("Thesis Breaker", globalResearch.thesisBreaker, globalResearch.thesisBreakerDetail, true),
            MasterBrainSubsystem("Forecast Distribution", globalResearch.forecastDistribution, globalResearch.forecastDistributionDetail, false),
            MasterBrainSubsystem("Scientific Validation Gate", globalResearch.scientificGate, globalResearch.scientificGateDetail, true),
            MasterBrainSubsystem("Forecast Autopsy", "OUTCOME REVIEW REQUIRED", "Forecast post-mortem requires stored prediction snapshots matched to completed horizon outcomes; this input is not currently provided to the controller.", false),
            MasterBrainSubsystem("Regime-Specific Strategy Router", "REGIME PROXY ONLY", "Strategy routing can reference the existing regime/analyst evidence, but validated per-regime strategy performance is not supplied here; no automatic strategy promotion.", false),
            MasterBrainSubsystem("Data Integrity Guardian", if (integrity.valid) "CURRENT CHECK PASSED" else "BLOCKED", "Current candle/timeframe integrity checks: ${integrity.valid}. ${integrity.reasons.take(3).joinToString()}", true),
            MasterBrainSubsystem("Prediction Tournament", "MODEL COMPARISON NOT RUN", "Existing analyst outputs are listed for comparison; no controlled tournament with common inputs and scored historical predictions is available.", false),
            MasterBrainSubsystem("Optimal Observation Engine", "WAIT-VALUE NOT CALCULATED", "Timeframe readings are available as context, but expected value of waiting for another candle is not modeled; no claim of optimal timing.", false),
            MasterBrainSubsystem("Performance Attribution", "ATTRIBUTION DATA MISSING", "Paper-trade outcome attribution by regime, timing, signal component and cost is not supplied to this master controller.", false),
            MasterBrainSubsystem("Historical Memory & Intelligent Waiting", "ENGINE ADDED / HISTORY INPUT REQUIRED", "HistoricalMemoryWaitingEngine compares supplied multi-year candle history with recent patterns, estimates 1h/2h historical outcomes, and recommends re-analysis timing; it is analysis-only and not yet wired to a 1–3 year history fetch in the live decision flow.", false),
            MasterBrainSubsystem("Unified Evidence-to-Decision Workflow", "CENTRAL GATE PRESENT / FULL PIPELINE WIRING REQUIRED", "Decision flow: verified data → historical memory → multi-analyst evidence → scenario/backtest validation → calibrated uncertainty → risk gates → final BUY/SELL/WAIT. This entry describes intended integration, not proof that every stage is fully connected.", true),
            MasterBrainSubsystem("Real Backtesting Validation", if (walkForward != null) "WALK-FORWARD RESULT AVAILABLE" else "BACKTEST EVIDENCE REQUIRED", "Use historical simulation with fees/slippage, closed candles, and no look-ahead; a report is not proof of robust performance.", true),
            MasterBrainSubsystem("Probability Calibration", "CALIBRATION EVIDENCE REQUIRED", "Confidence estimates must be checked against observed outcomes and calibration error; raw confidence is not a win probability.", true),
            MasterBrainSubsystem("Self-Learning Feedback Loop", if (adaptive.deepLearning.acceptedAsEvidence || adaptive.reinforcementLearning.acceptedAsEvidence) "SHADOW EVIDENCE AVAILABLE" else "OUTCOME FEEDBACK REQUIRED", "Store predictions, match them to completed outcomes, analyze errors, and only promote changes after controlled validation.", true),
            MasterBrainSubsystem("Data Integrity Gate", if (integrity.valid) "CURRENT CHECK PASSED" else "BLOCKED", "Reject stale, incomplete, malformed, or inconsistent market inputs before downstream analysis. Current gate reflects supplied integrity report only.", true),
            MasterBrainSubsystem("Prediction Competition", "CONTROLLED COMPARISON REQUIRED", "Compare analysts/strategies on identical inputs and historical windows; rank by measured results, not opinions or raw scores.", true),
            MasterBrainSubsystem("Adaptive Risk & Wait Decision", "RISK GATES ACTIVE / WAIT VALUE NOT PROVEN", "Choose entry, wait, or no-entry based on evidence conflicts, data quality, volatility, risk, and validated waiting value; scheduled reanalysis does not guarantee entry.", true),
            MasterBrainSubsystem("Unified Final Decision Engine", "FAIL-CLOSED FINAL GATE", "Consolidates subsystem evidence and blockers; may downgrade any proposal to WAIT, and must never override failed integrity or risk blockers.", true),
            MasterBrainSubsystem("Sequential Evidence Accumulator", "EVIDENCE ACCUMULATION NOT IMPLEMENTED", "Designed to accumulate independent, time-sequenced evidence and reduce confidence when new evidence conflicts; no persistent sequential evidence model is wired into this controller yet.", true),
            MasterBrainSubsystem("Market Novelty Detector", "NOVELTY MODEL REQUIRED", "Should compare the current market state against historical distributions and flag out-of-pattern conditions; no validated novelty score is provided here.", true),
            MasterBrainSubsystem("False Breakout & Trap Detector", "TRAP VALIDATION REQUIRED", "False-breakout checks may use existing rule-based market structure, but a separately validated trap-detection model is not supplied to this controller.", true),
            MasterBrainSubsystem("Opportunity Cost Brain", "WAIT VALUE NOT QUANTIFIED", "Should compare acting now with waiting for a better setup; expected opportunity cost and waiting value are not currently calculated.", true),
            MasterBrainSubsystem("Horizon Convergence Engine", "MULTI-HORIZON CONFLICT REVIEW", "Intended to compare short and higher timeframes and surface alignment/conflict; a dedicated convergence score is not yet connected.", true),
            MasterBrainSubsystem("Thesis Invalidation Engine", "INVALIDATION CHECK REQUIRED", "Should define evidence and price conditions that invalidate the current thesis; no separate invalidation lifecycle is passed into this controller yet.", true),
            MasterBrainSubsystem("Strategy Resource Allocator", "STRATEGY RANKING NOT VALIDATED", "Should rank strategies by measured, regime-specific out-of-sample results; no validated resource allocation or auto-promotion is performed.", true),
        )
        systems += MasterBrainSubsystem("Decision Stability / Anti-Flip Guard", "FLIP-FLOP CONTROL REQUIRED", "Track decision changes over successive evaluations; require fresh independent evidence and cooldown before reversing bias. A stable WAIT is preferred to oscillating BUY/SELL proposals when evidence is noisy.", true)
        systems += MasterBrainSubsystem("Spot vs Futures Context Firewall", "MODE-AWARE REVIEW REQUIRED", "Keep Spot and Futures assumptions separate. Futures-only leverage, liquidation, funding and contract constraints must not be silently applied to Spot, and Spot logic must not be reused as a Futures risk model.", true)
        systems += MasterBrainSubsystem("Futures Leverage & Position Size Guard", if (derivatives?.available == true && derivatives.blockers.isEmpty()) "DERIVATIVES CONTEXT AVAILABLE / SIZE CHECK REQUIRED" else "LEVERAGE AND POSITION DATA REQUIRED", "Before any Futures proposal, require explicit leverage, account equity, position size, stop distance, fees and slippage; calculate risk in account currency. Missing inputs must block Futures entry. No leverage or size is inferred.", true)
        systems += MasterBrainSubsystem("Liquidation Distance / Margin Guard", "LIQUIDATION DATA NOT VERIFIED", "For Futures, verify liquidation price/distance, maintenance margin and margin mode against exchange data. If liquidation risk cannot be calculated or is too close under validated thresholds, reject the entry. This controller currently receives no verified liquidation calculation.", true)
        systems += MasterBrainSubsystem("Funding / Basis / Open-Interest Review", "FUTURES METRICS NOT CONNECTED", "Review funding rate, mark/index basis and open-interest changes only when reliable timestamped feeds are supplied; these are contextual evidence, not standalone trade signals.", false)
        systems += MasterBrainSubsystem("Volatility Shock & Correlation Exposure Guard", "PORTFOLIO EXPOSURE INPUT REQUIRED", "During volatility shocks, gaps or correlated positions, reduce or block new exposure. Requires portfolio positions, correlation and volatility inputs; those are not assumed present in this report.", true)
        systems += MasterBrainSubsystem("Trade Plan & Exit Discipline", "EXIT PLAN REQUIRED", "Any Futures entry must have a predefined invalidation/stop, target or exit policy, risk budget and maximum loss before entry. Do not average down or increase leverage to recover losses; missing plan blocks entry.", true)
        systems += MasterBrainSubsystem("Post-Trade Futures Audit", "OUTCOME LOGGING REQUIRED", "Store the decision snapshot, leverage, size, funding, fees, slippage, stop/exit, realized outcome and reason for any deviation; review errors before changes are promoted from shadow mode.", true)
        systems += MasterBrainSubsystem("Operational Guard Wiring Audit", "UPSTREAM ENFORCEMENT EVIDENCE REQUIRED", "This audit exposes whether the supplied decision blockers cover stability/anti-flip, mode separation, Futures sizing and liquidation, funding/basis/OI, volatility/correlation and exit discipline. The master controller only enforces blockers actually passed in; missing upstream guard evidence must not be interpreted as a verified live guard. No autonomous Futures execution is authorized by this audit.", true)
        systems += MasterBrainSubsystem("Market Regime Early Warning", "REGIME CHANGE EVIDENCE REQUIRED", "Monitor regime-change precursors such as momentum weakening, volatility shifts and trend/range transitions. Existing regime indicators are contextual only; a separately validated early-warning score is not yet supplied.", false)
        systems += MasterBrainSubsystem("Liquidity Map Intelligence", "LIQUIDITY DATA REQUIRED", "Review order-book depth, liquidity concentrations and changes only when timestamped depth data is available. Candle-derived levels are proxies and must not be described as live liquidity walls.", false)
        systems += MasterBrainSubsystem("Event & News Impact Memory", "VERIFIED EVENT HISTORY REQUIRED", "Store timestamped events and measure subsequent market impact by asset, regime and horizon. Unverified headlines or missing event/outcome linkage cannot support a causal claim.", false)
        systems += MasterBrainSubsystem("Signal Contribution Intelligence", "FEATURE ATTRIBUTION NOT VALIDATED", "Attribute decision influence to evidence/features and assess their incremental value on controlled out-of-sample data. Correlated indicators must not be counted as independent votes.", false)
        systems += MasterBrainSubsystem("Cross-Market Dependency Brain", "DEPENDENCY MATRIX REQUIRED", "Analyze time-aligned BTC, ETH and other assets for dependency and correlation changes. Correlation is context, not causality; asset coverage and synchronized data are required.", false)
        systems += MasterBrainSubsystem("Execution Quality Intelligence", "EXECUTION COST DATA REQUIRED", "Evaluate spread, slippage, fees, liquidity and execution outcomes using actual or realistic market data. A signal is not execution-ready without cost-aware checks.", false)
        systems += MasterBrainSubsystem("Confidence Decay Engine", "TIME-DECAY MODEL NOT VALIDATED", "Reduce stale forecast confidence as its horizon expires or evidence changes, using a calibrated decay model. Do not decay confidence by an arbitrary fixed rule or imply a probability without validation.", false)
        systems += MasterBrainSubsystem("Strategy Stress Lab", "ROBUSTNESS TESTS REQUIRED", "Stress strategy results under price shocks, low liquidity, higher fees/slippage, false signals and regime shifts. Require out-of-sample and walk-forward evidence before promotion; no automatic live strategy promotion.", false)
        cognitive.modules.forEach { module ->
            systems += MasterBrainSubsystem("Cognitive: ${module.name}", module.state, module.detail, module.safetyCritical)
        }
        val unavailableMarkers = listOf("UNAVAILABLE", "NOT CONNECTED", "NOT RUN", "UNVERIFIED", "WARM-UP", "LIMITED", "INSUFFICIENT", "GUARD", "PARTIAL", "NOT PROMOTED", "REJECTED")
        val connected = systems.count { system -> unavailableMarkers.none { marker -> system.status.contains(marker, true) } }
        val readiness = (connected * 100 / systems.size).coerceIn(0, 100)
        val failClosed = blockers.distinct().toMutableList()
        if (!integrity.valid && failClosed.none { it.contains("integrity", true) }) failClosed += "Master Brain: data integrity failed."
        // This control layer can downgrade a proposal to WAIT; it never upgrades a blocked decision.
        val finalAction = if (integrity.valid && allowed && proposedAction == "BUY" && failClosed.isEmpty()) "BUY" else if (integrity.valid && proposedAction == "SELL" && failClosed.isEmpty()) "SELL" else "WAIT"
        val gate = if (finalAction == proposedAction && finalAction in setOf("BUY", "SELL")) "FINAL GATE PASSED" else "FINAL GATE: WAIT / BLOCKED"
        val summary = "Central controller reviewed ${systems.size} subsystem records: $connected with evidence/status; $finalAction is the final fail-closed action. Readiness is a module-status count, not model accuracy."
        return MasterControlBrainReport("NEXORA MASTER CONTROL BRAIN", finalAction, gate, connected, systems.size, readiness, systems, summary, failClosed)
    }
}
