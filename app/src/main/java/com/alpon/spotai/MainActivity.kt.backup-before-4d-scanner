data class Holding(val symbol:String,val quantity:Double,val average:Double)
data class ScanRow(val symbol:String,val price:Double,val change:Double,val signal:Signal)
class SpotViewModel(app:Application):AndroidViewModel(app){
    private val repo=BinanceRepository()
    private val prefs=app.getSharedPreferences("portfolio",0)
    var symbol by mutableStateOf("BTCUSDT"); private set
    var interval by mutableStateOf("1h"); private set
    var ticker by mutableStateOf<TickerDto?>(null); private set
    var candles by mutableStateOf<List<Candle>>(emptyList()); private set
    var signal by mutableStateOf<Signal?>(null); private set
    var loading by mutableStateOf(false); private set
    var error by mutableStateOf<String?>(null); private set
    var markets by mutableStateOf<List<TickerDto>>(emptyList()); private set
    var scanning by mutableStateOf(false); private set
    var scanRows by mutableStateOf<List<ScanRow>>(emptyList()); private set
    var holdings by mutableStateOf<List<Holding>>(emptyList()); private set
    init { holdings = prefs.getString("holdings","")!!.split(";").mapNotNull { row -> val p=row.split("|"); if(p.size==3) runCatching { Holding(p[0],p[1].toDouble(),p[2].toDouble()) }.getOrNull() else null } }
    var scanInterval by mutableStateOf("1h"); private set
    fun select(s:String){symbol=s;load()}; fun setInterval(v:String){interval=v;load()}; fun setScanInterval(v:String){scanInterval=v}
    fun load(){ viewModelScope.launch { loading=true;error=null; try { val snap=repo.snapshot(symbol,interval); ticker=snap.ticker;candles=snap.candles;signal=TechnicalAnalysis.analyze(candles); if(signal==null) error="Not enough candle history to calculate all indicators." }catch(e:Exception){error=e.message?:"Unable to load Binance market data."};loading=false } }
    fun loadMarkets(){viewModelScope.launch {try{markets=repo.allTickers().filter{it.symbol.endsWith("USDT")}.sortedByDescending{it.quoteVolume.toDoubleOrNull()?:0.0}.take(50)}catch(e:Exception){error=e.message?:"Unable to load markets."}}}
    fun scan(){viewModelScope.launch { scanning=true;scanRows= emptyList();try{val top=repo.allTickers().filter{it.symbol.endsWith("USDT") && !it.symbol.contains("UPUSDT") && !it.symbol.contains("DOWNUSDT")}.sortedByDescending{it.quoteVolume.toDoubleOrNull()?:0.0}.take(25); val rows= mutableListOf<ScanRow>(); for(t in top){ try{val c=repo.candles(t.symbol,scanInterval); val a=TechnicalAnalysis.analyze(c);if(a!=null && a.action!="WAIT") rows.add(ScanRow(t.symbol,t.lastPrice.toDouble(),t.priceChangePercent.toDouble(),a))}catch(_:Exception){}};scanRows=rows.sortedByDescending{it.signal.score} }catch(e:Exception){error=e.message?:"Scanner request failed."};scanning=false } }
    private fun persistHoldings(){prefs.edit().putString("holdings",holdings.joinToString(";"){"${it.symbol}|${it.quantity}|${it.average}"}).apply()}
    fun addHolding(h:Holding){holdings=(holdings.filterNot{it.symbol==h.symbol}+h);persistHoldings()}; fun removeHolding(h:Holding){holdings=holdings-h;persistHoldings()}
    fun currentPrice(s:String)=markets.firstOrNull{it.symbol==s}?.lastPrice?.toDoubleOrNull()
}
