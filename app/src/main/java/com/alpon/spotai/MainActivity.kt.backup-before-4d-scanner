@Composable fun PortfolioScreen(vm:SpotViewModel) {
    var show by remember { mutableStateOf(false) }
    var sym by remember { mutableStateOf("BTCUSDT") }
    var qty by remember { mutableStateOf("") }
    var avg by remember { mutableStateOf("") }
    val total = vm.holdings.sumOf { (vm.currentPrice(it.symbol) ?: 0.0) * it.quantity }
    Column(Modifier.fillMaxSize()) {
        Row(Modifier.fillMaxWidth(), horizontalArrangement=Arrangement.SpaceBetween, verticalAlignment=Alignment.CenterVertically) {
            Text("YOUR PORTFOLIO", color=Color.White, fontWeight=FontWeight.Bold)
            Button(onClick={show=true}) { Icon(Icons.Default.Add,null); Text(" Add asset") }
        }
        CardBox {
            Text("TOTAL VALUE",color=Muted,fontSize=10.sp)
            Text(fmt(total),color=Color.White,fontSize=29.sp,fontWeight=FontWeight.Bold)
            Text("USDT • Based on latest available prices",color=Muted,fontSize=10.sp)
        }
        if(vm.holdings.isEmpty()) {
            Text("No assets yet. Add a holding to track your portfolio.",color=Muted)
        } else {
            LazyColumn(Modifier.weight(1f)) {
                items(vm.holdings) { h ->
                    val price=vm.currentPrice(h.symbol)
                    val value=(price ?: 0.0)*h.quantity
                    val pnl=price?.let { (it-h.average)*h.quantity }
                    CardBox {
                        Row(Modifier.fillMaxWidth(),horizontalArrangement=Arrangement.SpaceBetween,verticalAlignment=Alignment.CenterVertically) {
                            Column { Text(h.symbol,color=Color.White,fontWeight=FontWeight.Bold); Text("${h.quantity} units • Avg ${fmt(h.average)}",color=Muted,fontSize=11.sp) }
                            Column(horizontalAlignment=Alignment.End) {
                                Text(price?.let{fmt(value)} ?: "Price unavailable",color=Color.White,fontWeight=FontWeight.Bold)
                                Text(pnl?.let { "${if(it>=0)"+" else ""}${fmt(it)} USDT" } ?: "P/L unavailable",color=if((pnl ?: 0.0)>=0)Green else Red,fontSize=11.sp)
                            }
                        }
                        TextButton(onClick={vm.removeHolding(h)}) { Text("Remove",color=Red) }
                    }
                }
            }
        }
    }
    if(show) AlertDialog(
        onDismissRequest={show=false}, title={Text("Add portfolio asset")},
        text={Column {
            OutlinedTextField(sym,{sym=it.uppercase()},label={Text("Trading pair")})
            OutlinedTextField(qty,{qty=it},label={Text("Quantity")},keyboardOptions=KeyboardOptions(keyboardType=KeyboardType.Decimal))
            OutlinedTextField(avg,{avg=it},label={Text("Average purchase price (USDT)")},keyboardOptions=KeyboardOptions(keyboardType=KeyboardType.Decimal))
        }},
        confirmButton={TextButton(onClick={val q=qty.toDoubleOrNull();val a=avg.toDoubleOrNull();if(sym.endsWith("USDT")&&q!=null&&q>0&&a!=null&&a>0){vm.addHolding(Holding(sym,q,a));show=false}}){Text("Save")}},
        dismissButton={TextButton(onClick={show=false}){Text("Cancel")}}
    )
}
