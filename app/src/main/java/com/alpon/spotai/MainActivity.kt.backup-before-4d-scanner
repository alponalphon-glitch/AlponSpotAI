@Composable fun CandleChart(c:List<Candle>){Canvas(Modifier.fillMaxWidth().height(205.dp)){val data=c.takeLast(65);if(data.isEmpty())return@Canvas;val lo=data.minOf{it.low};val hi=data.maxOf{it.high};val range=(hi-lo).coerceAtLeast(.0000001);val step=size.width/data.size;for(i in 0..4){val y=size.height*i/4;drawLine(Muted.copy(alpha=.15f),Offset(0f,y),Offset(size.width,y),1f)};data.forEachIndexed{i,v->val x=step*(i+.5f);val y={p:Double->size.height*.78f-((p-lo)/range*size.height*.76f).toFloat()};val up=v.close>=v.open;val color=if(up)Green else Red;drawLine(color,Offset(x,y(v.high)),Offset(x,y(v.low)),1.5f);val top=y(maxOf(v.open,v.close));val bottom=y(minOf(v.open,v.close));drawLine(color,Offset(x,top),Offset(x,bottom.coerceAtLeast(top+2f)),(step*.55f).coerceAtLeast(2f),StrokeCap.Square);val maxVol=data.maxOf{it.volume}.coerceAtLeast(1.0);val vh=(v.volume/maxVol*size.height*.18f).toFloat();drawLine(color.copy(alpha=.38f),Offset(x,size.height-1f),Offset(x,size.height-vh), (step*.55f).coerceAtLeast(1f))}}}
