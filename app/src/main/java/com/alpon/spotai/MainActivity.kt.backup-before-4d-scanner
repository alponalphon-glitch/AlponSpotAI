fun fmt(v:Double):String=if(!v.isFinite())"—" else String.format(Locale.US,"%,.4f",v).trimEnd('0').trimEnd('.')
fun compact(v:Double)=when{v>=1e9->"%.2fB".format(v/1e9);v>=1e6->"%.2fM".format(v/1e6);v>=1e3->"%.2fK".format(v/1e3);else->"%.0f".format(v)}
