private fun tr(key:String,language:String):String = translations[language]?.get(key) ?: key

@Composable fun SpotApp(vm:SpotViewModel= viewModel()) {
    val context= LocalContext.current
    val prefs= remember { context.getSharedPreferences("app_preferences",0) }
    var language by remember { mutableStateOf(prefs.getString("language","en") ?: "en") }
    var tab by remember { mutableStateOf("Home") }
    var menuOpen by remember { mutableStateOf(false) }
    var page by remember { mutableStateOf<String?>(null) }
    LaunchedEffect(Unit){vm.load();vm.loadMarkets()}
    val nav=listOf("Home" to Icons.Default.Home,"Markets" to Icons.Default.ShowChart,"Scanner" to Icons.Default.Radar,"Portfolio" to Icons.Default.AccountBalanceWallet,"Settings" to Icons.Default.Settings)
    Scaffold(containerColor=Bg,bottomBar={
        if(page==null) NavigationBar(containerColor=Panel,contentColor=Muted,modifier=Modifier.heightIn(min=62.dp)) {
            nav.forEach{(name,icon)->val label=tr(name,language);NavigationBarItem(selected=tab==name,onClick={tab=name;if(name=="Markets")vm.loadMarkets();if(name=="Scanner")vm.scan()},icon={Icon(icon,null)},label={Text(label,fontSize=10.sp,maxLines=1)},colors=NavigationBarItemDefaults.colors(selectedIconColor=Cyan,selectedTextColor=Cyan,indicatorColor=Blue.copy(alpha=.14f),unselectedIconColor=Muted,unselectedTextColor=Muted))}
        }
    }) { pad ->
        Column(Modifier.fillMaxSize().padding(pad).padding(horizontal=14.dp)) {
            Row(Modifier.fillMaxWidth().padding(top=8.dp,bottom=12.dp),horizontalArrangement=Arrangement.SpaceBetween,verticalAlignment=Alignment.CenterVertically) {
                Row(verticalAlignment=Alignment.CenterVertically) {
                    if(page!=null) IconButton(onClick={page=null},modifier=Modifier.size(34.dp)) { Icon(Icons.Default.ArrowBack,null,tint=Cyan) }
                    Column { Text("ALPON",fontSize=11.sp,color=Cyan,fontWeight=FontWeight.Bold,letterSpacing=3.sp);Text("SPOT AI",fontSize=22.sp,color=Color.White,fontWeight=FontWeight.ExtraBold) }
                }
                Row(verticalAlignment=Alignment.CenterVertically) {
                    Box(Modifier.size(7.dp).background(Green,CircleShape));Spacer(Modifier.width(6.dp));Text("BINANCE SPOT",fontSize=9.sp,color=Muted)
                    Box {
                        IconButton(onClick={menuOpen=true},modifier=Modifier.size(42.dp)) { Icon(Icons.Default.Menu,tr("Menu",language),tint=Cyan) }
                        DropdownMenu(expanded=menuOpen,onDismissRequest={menuOpen=false},modifier=Modifier.background(Brush.linearGradient(listOf(Color(0xFF1B3552),Color(0xFF0B1423))),RoundedCornerShape(18.dp))) {
                            listOf("My account" to Icons.Default.Person,"Settings" to Icons.Default.Settings,"Support" to Icons.Default.SupportAgent).forEach { (label,icon)->
                                DropdownMenuItem(text={Text(tr(label,language),color=Color.White,fontWeight=FontWeight.SemiBold)},leadingIcon={Icon(icon,null,tint=Cyan)},onClick={menuOpen=false;page=label})
                            }
                        }
                    }
                }
            }
            when {
                page=="My account" -> AccountScreen(language)
                page=="Settings" -> SettingsScreen(language){newLang->language=newLang;prefs.edit().putString("language",newLang).apply()}
                page=="Support" -> SupportScreen(language)
                else -> when(tab){"Home"->HomeScreen(vm);"Markets"->MarketsScreen(vm){tab="Home"};"Scanner"->ScannerScreen(vm){tab="Home"};"Portfolio"->PortfolioScreen(vm);else->SettingsScreen(language){newLang->language=newLang;prefs.edit().putString("language",newLang).apply()}}
            }
        }
    }
}
