                        Text("READ FULL STORY  ↗",color=Blue,fontSize=10.sp,fontWeight=FontWeight.Bold,modifier=Modifier.clickable { runCatching { context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(item.url))) } }.padding(6.dp))
                    }
                }
            }
        }
        if(vm.newsLoading && vm.news.isNotEmpty()) LinearProgressIndicator(Modifier.fillMaxWidth(),color=Cyan)
        vm.newsError?.takeIf{vm.news.isNotEmpty()}?.let { Text(it,color=Muted,fontSize=10.sp,modifier=Modifier.padding(bottom=8.dp)) }
        Text("Headlines are provided by their publishers. News may be delayed; verify important information at the original source.",color=Muted,fontSize=9.sp,modifier=Modifier.padding(bottom=8.dp))
    }
}

private fun relativeNewsTime(timestamp: Long): String {
    val minutes=((System.currentTimeMillis()-timestamp).coerceAtLeast(0L)/60_000L)
    return when { minutes<1 -> "Just now"; minutes<60 -> "${minutes}m ago"; minutes<1440 -> "${minutes/60}h ago"; else -> "${minutes/1440}d ago" }
}

