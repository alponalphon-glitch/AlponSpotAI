data class ScanRow(val symbol:String,val price:Double,val change:Double,val signal:Signal)
class SpotViewModel(app:Application):AndroidViewModel(app){
    private val repo=BinanceRepository()
    private val liveClient=OkHttpClient()
    @Volatile private var liveSocket:WebSocket?=null
    @Volatile private var liveGeneration=0
    var liveStatus by mutableStateOf("CONNECTING")
        private set
    private val newsRepo=CryptoNewsRepository()
    private val prefs=app.getSharedPreferences("portfolio",0)
    var symbol by mutableStateOf("BTCUSDT"); private set
    var interval by mutableStateOf("1h"); private set
    var ticker by mutableStateOf<TickerDto?>(null); private set
    var candles by mutableStateOf<List<Candle>>(emptyList()); private set
    var signal by mutableStateOf<Signal?>(null); private set
    var loading by mutableStateOf(false); private set
    var error by mutableStateOf<String?>(null); private set
    var markets by mutableStateOf<List<TickerDto>>(emptyList()); private set
    var scanning by mutableStateOf(false); private set
    var scanRows by mutableStateOf<List<ScanRow>>(emptyList()); private set
    var holdings by mutableStateOf<List<Holding>>(emptyList()); private set
    var news by mutableStateOf<List<CryptoNewsItem>>(emptyList()); private set
    var newsLoading by mutableStateOf(false); private set
    var newsError by mutableStateOf<String?>(null); private set
    init { holdings = prefs.getString("holdings","")!!.split(";").mapNotNull { row -> val p=row.split("|"); if(p.size==3) runCatching { Holding(p[0],p[1].toDouble(),p[2].toDouble()) }.getOrNull() else null } }
    var scanInterval by mutableStateOf("1h"); private set
    fun select(s:String){symbol=s;load()}; fun changeInterval(v:String){interval=v;load()}; fun changeScanInterval(v:String){scanInterval=v;interval=v;load()}
    fun load(){
        if (loading) return
        viewModelScope.launch {
            loading=true; error=null
            try {
                val requestedSymbol=symbol; val requestedInterval=interval
                val snap=repo.snapshot(requestedSymbol,requestedInterval)
                // Ignore a late response if the user changed pair/timeframe while it was loading.
                if (requestedSymbol==symbol && requestedInterval==interval) {
                    ticker=snap.ticker; candles=snap.candles
                    signal=TechnicalAnalysis.analyze(snap.candles,requestedInterval)
                    if(signal==null) error="Analysis unavailable: Binance returned insufficient closed-candle history."
                }
            } catch(e:Exception) {
                error=e.message?:"Unable to load Binance market data."
                signal=null
            } finally { loading=false }
        }
    }
    fun startLiveStream(){
        val generation=++liveGeneration
        liveSocket?.close(1000,"Market changed")
        connectLiveStream(generation)
    }
    fun stopLiveStream(){liveGeneration++;liveSocket?.close(1000,"Screen closed");liveSocket=null;liveStatus="PAUSED"}
    private fun connectLiveStream(generation:Int){
        val streamSymbol=symbol.lowercase(Locale.US)
        val streamInterval=interval
        liveStatus="CONNECTING"
        val request=Request.Builder().url("wss://stream.binance.com:9443/stream?streams=${streamSymbol}@kline_${streamInterval}/${streamSymbol}@trade").build()
        liveSocket=liveClient.newWebSocket(request,object:WebSocketListener(){
            override fun onOpen(webSocket:WebSocket,response:Response){if(generation==liveGeneration)liveStatus="LIVE" else webSocket.close(1000,"Stale stream")}
            override fun onMessage(webSocket:WebSocket,text:String){
                if(generation!=liveGeneration)return
                runCatching {
                    val envelope=JSONObject(text);val root=envelope.optJSONObject("data") ?: envelope
                    if(root.optString("e")=="trade"){
                        val price=root.getString("p").toDouble();val old=candles
                        if(old.isNotEmpty()){
                            val last=old.last();val live=last.copy(high=maxOf(last.high,price),low=minOf(last.low,price),close=price)
                            candles=old.dropLast(1)+live
                        }
                        ticker=ticker?.copy(lastPrice=root.getString("p"))
                    } else if(root.optString("e")=="kline"){
                        val k=root.getJSONObject("k")
                        val candle=Candle(k.getLong("t"),k.getString("o").toDouble(),k.getString("h").toDouble(),k.getString("l").toDouble(),k.getString("c").toDouble(),k.getString("v").toDouble())
                        val old=candles
                        candles=if(old.lastOrNull()?.time==candle.time) old.dropLast(1)+candle else if(old.any{it.time==candle.time}) old.map{if(it.time==candle.time)candle else it} else (old+candle).takeLast(300)
                        ticker=ticker?.copy(lastPrice=k.getString("c"))
                        if(k.optBoolean("x",false))signal=TechnicalAnalysis.analyze(candles,streamInterval)
                    }
                }
            }
            override fun onFailure(webSocket:WebSocket,t:Throwable,response:Response?){
                if(generation==liveGeneration){liveStatus="RECONNECTING";viewModelScope.launch{delay(3000);if(generation==liveGeneration)connectLiveStream(generation)}}
            }
            override fun onClosed(webSocket:WebSocket,code:Int,reason:String){if(generation==liveGeneration)liveStatus="DISCONNECTED"}
        })
    }
    fun loadMarkets(){viewModelScope.launch {try{markets=repo.topSpotUsdtMarkets(500)}catch(e:Exception){error=e.message?:"Unable to load Binance Spot markets."}}}
    fun loadNews(){ if(newsLoading) return; viewModelScope.launch { newsLoading=true; newsError=null; try { val latest=newsRepo.latest24Hours(); news=latest; if(latest.isEmpty()) newsError="No crypto headlines from the last 24 hours are available right now. Try again later." } catch(e:Exception) { newsError=e.message?:"Unable to load crypto news." } finally { newsLoading=false } } }
    fun scan(){viewModelScope.launch { scanning=true;scanRows= emptyList();try{val top=repo.allTickers().filter{it.symbol.endsWith("USDT") && !it.symbol.contains("UPUSDT") && !it.symbol.contains("DOWNUSDT")}.sortedByDescending{it.quoteVolume.toDoubleOrNull()?:0.0}.take(25); val rows= mutableListOf<ScanRow>(); for(t in top){ try{val c=repo.candles(t.symbol,scanInterval); val a=TechnicalAnalysis.analyze(c,scanInterval);if(a!=null && a.action!="WAIT") rows.add(ScanRow(t.symbol,t.lastPrice.toDouble(),t.priceChangePercent.toDouble(),a))}catch(_:Exception){}};scanRows=rows.sortedByDescending{it.signal.score} }catch(e:Exception){error=e.message?:"Scanner request failed."};scanning=false } }
    private fun persistHoldings(){prefs.edit().putString("holdings",holdings.joinToString(";"){"${it.symbol}|${it.quantity}|${it.average}"}).apply()}
    fun addHolding(h:Holding){holdings=(holdings.filterNot{it.symbol==h.symbol}+h);persistHoldings()}; fun removeHolding(h:Holding){holdings=holdings-h;persistHoldings()}
    fun currentPrice(s:String)=markets.firstOrNull{it.symbol==s}?.lastPrice?.toDoubleOrNull()
}
