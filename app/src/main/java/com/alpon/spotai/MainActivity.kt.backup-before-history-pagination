@Composable fun MarketPairPicker(vm: SpotViewModel) {
    var open by remember { mutableStateOf(false) }
    var query by remember { mutableStateOf("") }
    val matches = remember(query, vm.markets) {
        vm.markets.asSequence().filter { it.symbol.contains(query.trim().uppercase()) }.take(100).toList()
    }
    OutlinedButton(onClick = { query = ""; open = true }, modifier = Modifier.fillMaxWidth(), colors = ButtonDefaults.outlinedButtonColors(contentColor = Cyan)) {
        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
            Text("Choose Binance Spot pair  •  ${vm.markets.size.coerceAtMost(500)} markets", fontSize = 12.sp)
            Icon(Icons.Default.ExpandMore, contentDescription = "Choose market")
        }
    }
    if (open) AlertDialog(
        onDismissRequest = { open = false },
        title = { Text("Binance Spot markets", color = Color.White) },
        text = {
            Column {
                OutlinedTextField(value = query, onValueChange = { query = it }, modifier = Modifier.fillMaxWidth(), singleLine = true, label = { Text("Search up to 500 USDT pairs") })
                Spacer(Modifier.height(8.dp))
                if (vm.markets.isEmpty()) Text("Market list is loading. Check your connection and refresh.", color = Muted, fontSize = 12.sp)
                else LazyColumn(Modifier.heightIn(max = 420.dp)) {
                    items(matches, key = { it.symbol }) { market ->
                        Row(Modifier.fillMaxWidth().clickable { vm.select(market.symbol); open = false }.padding(vertical = 10.dp), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
                            Column(Modifier.weight(1f)) {
                                Text(market.symbol, color = Color.White, fontWeight = FontWeight.Bold)
                                Text("24h volume ${compact(market.quoteVolume.toDoubleOrNull() ?: 0.0)} USDT", color = Muted, fontSize = 10.sp)
                            }
                            Column(horizontalAlignment = Alignment.End) {
                                Text(fmt(market.lastPrice.toDoubleOrNull() ?: 0.0), color = Color.White, fontSize = 12.sp)
                                val change = market.priceChangePercent.toDoubleOrNull() ?: 0.0
