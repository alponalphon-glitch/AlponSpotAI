    fun load(){
        if (loading) return
        viewModelScope.launch {
            loading = true
            error = null
            val requestedSymbol = symbol
            val requestedInterval = interval
            multiTimeframeSignal = null
            priceActionReport = null
            multiTimeframeError = "Loading 12 Binance timeframes and long-horizon history…"

            try {
                // Show previously cached candles immediately while Binance refreshes.
                val cachedCandles = withContext(Dispatchers.IO) {
                    runCatching {
                        candleDao.getLatestCandles(
                            requestedSymbol,
                            requestedInterval,
                            1000
                        ).map { it.toCandle() }.reversed()
                    }.getOrDefault(emptyList())
                }

                if (cachedCandles.isNotEmpty() &&
                    requestedSymbol == symbol &&
                    requestedInterval == interval) {
                    candles = cachedCandles
                    signal = TechnicalAnalysis.analyze(cachedCandles, requestedInterval)
                    marketStructure = MarketStructureAnalysis.analyze(cachedCandles)
                    updateAiAnalysis()
                }

                val snap = repo.snapshot(requestedSymbol, requestedInterval)

                // Persist the latest Binance candles in Room.
                withContext(Dispatchers.IO) {
                    if (snap.candles.isNotEmpty()) {
                        candleDao.insertAll(
                            snap.candles.map {
                                it.toEntity(requestedSymbol, requestedInterval)
                            }
                        )
                    }
                }

                if (requestedSymbol == symbol && requestedInterval == interval) {
                    refreshHistoryStats()
                    ticker = snap.ticker
                    candles = snap.candles
                    signal = TechnicalAnalysis.analyze(snap.candles, requestedInterval)
                    marketStructure = MarketStructureAnalysis.analyze(snap.candles)
                    updateAiAnalysis()
                    if (signal == null) {
                        error = "Analysis unavailable: insufficient closed-candle history."
                    }
                }

                // Multi-timeframe analysis uses real Binance candles.
                if (requestedSymbol == symbol) {
                    try {
                        // Binance-native 12-frame context, from monthly macro trend to 5-minute execution.
                        val oneMonth = repo.candles(requestedSymbol, "1M")
                        val oneWeek = repo.candles(requestedSymbol, "1w")
                        val threeDay = repo.candles(requestedSymbol, "3d")
                        val daily = repo.candles(requestedSymbol, "1d")
                        val twelveHour = repo.candles(requestedSymbol, "12h")
                        val eightHour = repo.candles(requestedSymbol, "8h")
                        val fourHour = repo.candles(requestedSymbol, "4h")
                        val twoHour = repo.candles(requestedSymbol, "2h")
                        val hourly = repo.candles(requestedSymbol, "1h")
                        val thirtyMin = repo.candles(requestedSymbol, "30m")
                        val fifteenMin = repo.candles(requestedSymbol, "15m")
                        val fiveMin = repo.candles(requestedSymbol, "5m")

                        val result = MultiTimeframeAnalysis.analyze(
                            oneMonth, oneWeek, threeDay, daily, twelveHour, eightHour,
                            fourHour, twoHour, hourly, thirtyMin, fifteenMin, fiveMin
                        )
                        val priceAction = PriceActionAnalysis.analyze(daily, oneWeek, oneMonth)

                        if (requestedSymbol == symbol) {
                            multiTimeframeSignal = result
                            priceActionReport = priceAction
                            updateAiAnalysis()
                            multiTimeframeError = if (result == null) {
                                "Insufficient Binance candle history for all timeframes."
                            } else null
                        }
                    } catch (e: Exception) {
                        if (requestedSymbol == symbol) {
                            multiTimeframeSignal = null
                            updateAiAnalysis()
                            multiTimeframeError =
                                e.message ?: "Unable to load multi-timeframe Binance data."
                        }
                    }
                }
            } catch (e: Exception) {
                error = e.message ?: "Unable to load Binance market data."
                signal = null
            } finally {
                loading = false
            }
        }
    }

    fun downloadFullHistory(){
        if(fullHistoryLoading || loading) return

        val requestedSymbol = symbol
        val requestedInterval = interval

        viewModelScope.launch {
            fullHistoryLoading = true
            fullHistoryDownloaded = 0
            fullHistoryError = null

            try {
                val total = withContext(Dispatchers.IO) {
                    historyRepo.downloadFullHistory(
                        requestedSymbol,
                        requestedInterval
                    ) { downloaded, _ ->
                        viewModelScope.launch {
                            if(requestedSymbol == symbol &&
                                requestedInterval == interval) {
                                fullHistoryDownloaded = downloaded
                            }
                        }
                    }
                }

                if(requestedSymbol == symbol &&
                    requestedInterval == interval &&
                    total == 0) {
                    fullHistoryError =
                        "No new history downloaded. History may already be complete or unavailable."
                }
            } catch(e: Exception) {
                if(requestedSymbol == symbol &&
                    requestedInterval == interval) {
                    fullHistoryError =
                        e.message ?: "Full history download failed."
                }
            } finally {
                fullHistoryLoading = false
                if(requestedSymbol == symbol && requestedInterval == interval){
                    refreshHistoryStats()
                }
            }
        }
    }

    fun loadOlderHistory(){
        if(historyLoading || loading || historyExhausted || candles.isEmpty()) return
        val requestedSymbol=symbol
        val requestedInterval=interval
        val oldestTime=candles.first().time

        viewModelScope.launch {
            historyLoading=true
            try {
                val page=repo.candlesBefore(
                    requestedSymbol,
                    requestedInterval,
                    oldestTime-1L,
                    1000
                )

                if (page.isNotEmpty()) {
                    withContext(Dispatchers.IO) {
                        candleDao.insertAll(
                            page.map { it.toEntity(requestedSymbol, requestedInterval) }
                        )
                    }
                }

                if(requestedSymbol==symbol && requestedInterval==interval){
                    val merged=(page+candles)
                        .distinctBy{it.time}
                        .sortedBy{it.time}
                    candles=merged
                    signal=TechnicalAnalysis.analyze(merged,requestedInterval)
                    marketStructure=MarketStructureAnalysis.analyze(merged)
                    updateAiAnalysis()
                    if(page.isEmpty() || page.size<1000 ||
                        merged.firstOrNull()?.time==oldestTime){
                        historyExhausted=true
                    }
                    refreshHistoryStats()
                }
            }catch(e:Exception){
                error=e.message?:"Unable to load older Binance candles."
            }finally{
                historyLoading=false
            }
        }
    }

