@Composable fun InteractiveCandleChart(c:List<Candle>,layers:ChartLayers,modifier:Modifier=Modifier,structure:MarketStructureReport?=null,priceAction:PriceActionReport?=null,smartMoney:SmartMoneyReport?=null){
    var zoom by remember{mutableFloatStateOf(1f)};var pan by remember{mutableFloatStateOf(0f)}
    Canvas(modifier.background(Color(0xFF091321),RoundedCornerShape(12.dp)).pointerInput(Unit){detectTransformGestures{_,panChange,zoomChange,_->zoom=(zoom*zoomChange).coerceIn(1f,4f);pan=(pan+panChange.x).coerceIn(-4000f,4000f)}}){
        val all=c;if(all.isEmpty())return@Canvas
        val count=(all.size/zoom).toInt().coerceAtLeast(12).coerceAtMost(all.size)
        val maxStart=(all.size-count).coerceAtLeast(0)
        val shift=(maxStart+(-pan/(size.width.coerceAtLeast(1f))*count).toInt()).coerceIn(0,maxStart)
        val data=all.drop(shift).take(count)
        val priceLo=data.minOf{it.low};val priceHi=data.maxOf{it.high};val range=(priceHi-priceLo).coerceAtLeast(kotlin.math.abs(priceHi)*0.000001).coerceAtLeast(1e-10);val topPad=size.height*.08f;val chartBottom=size.height*.78f;val step=size.width/data.size
        val y:(Double)->Float={v->chartBottom-((v-priceLo)/range*(chartBottom-topPad)).toFloat()}
        for(i in 0..5){val yy=topPad+(chartBottom-topPad)*i/5f;drawLine(Muted.copy(alpha=.17f),Offset(0f,yy),Offset(size.width,yy),1f)}
        val maxVol=data.maxOf{it.volume}.coerceAtLeast(1.0)
        data.forEachIndexed{i,v->val x=step*(i+.5f);val color=if(v.close>=v.open)Green else Red;drawLine(color,Offset(x,y(v.high)),Offset(x,y(v.low)),1.4f);val bodyTop=y(maxOf(v.open,v.close));val bodyBottom=y(minOf(v.open,v.close));drawLine(color.copy(alpha=.9f),Offset(x,bodyTop),Offset(x,bodyBottom.coerceAtLeast(bodyTop+2f)),(step*.62f).coerceAtLeast(2f),StrokeCap.Square);val vh=(v.volume/maxVol*size.height*.16f).toFloat();drawLine(color.copy(alpha=.4f),Offset(x,size.height-2f),Offset(x,size.height-vh), (step*.55f).coerceAtLeast(1f))}
        // Shared time mapping for all market-structure and Smart Money overlays.
        val firstTime = data.first().time
        val lastTime = data.last().time
        val duration = (lastTime-firstTime).toDouble().coerceAtLeast(1.0)
        fun xAt(time:Long):Float =
            step*.5f + ((time-firstTime).toDouble()/duration).toFloat()*(size.width-step)
        // Market structure overlays: support/resistance, trendlines and FVG.
        structure?.let { report ->
            report.support.forEach { level ->
                if (level.price in priceLo..priceHi) {
                    val yy = y(level.price)
                    drawLine(Color(0xFF26D98A).copy(alpha=.72f), Offset(0f,yy), Offset(size.width,yy), 1.5f)
                }
            }
            report.resistance.forEach { level ->
                if (level.price in priceLo..priceHi) {
                    val yy = y(level.price)
                    drawLine(Color(0xFFFF647C).copy(alpha=.72f), Offset(0f,yy), Offset(size.width,yy), 1.5f)
                }
            }
            report.swingPoints.filter { it.time in firstTime..lastTime }.forEach { swing ->
                val x=xAt(swing.time)
                val color=if(swing.type=="LOW") Color(0xFF26D98A) else Color(0xFFFF647C)
                drawCircle(color.copy(alpha=.9f),radius=2.8f,center=Offset(x,y(swing.price)))
            }
            report.trendLines.forEach { line ->
                val x1=xAt(line.startTime)
                val x2=xAt(lastTime)
                val projectedPrice = line.priceAt(lastTime)
                val color=if(line.type.contains("SUPPORT",true) || line.type.contains("BULL",true))
                    Color(0xFF26D98A) else Color(0xFFFF647C)
                if (projectedPrice.isFinite() && projectedPrice > 0.0) {
                    drawLine(color.copy(alpha=.9f),Offset(x1,y(line.startPrice)),Offset(x2,y(projectedPrice)),2f)
                }
            }
            report.fairValueGaps.forEach { gap ->
                if(gap.time in firstTime..lastTime && gap.high>=priceLo && gap.low<=priceHi) {
                    val left=xAt(gap.time).coerceIn(0f,size.width)
                    val right=(left+step*5f).coerceAtMost(size.width)
                    val top=y(gap.high).coerceIn(topPad,chartBottom)
                    val bottom=y(gap.low).coerceIn(topPad,chartBottom)
                    val color=if(gap.type.contains("BULL",true)) Color(0xFF26D98A) else Color(0xFFFF647C)
                    if(right>left && bottom>top) {
                        drawRect(color.copy(alpha=.13f),Offset(left,top),
                            androidx.compose.ui.geometry.Size(right-left,bottom-top))
                    }
                }
            }
        }
        smartMoney?.orderBlocks?.forEach { zone ->
            if (zone.high >= priceLo && zone.low <= priceHi) {
                val left = if (zone.originTime in firstTime..lastTime) xAt(zone.originTime).coerceIn(0f, size.width) else 0f
                val top = y(zone.high).coerceIn(topPad, chartBottom)
                val bottom = y(zone.low).coerceIn(topPad, chartBottom)
                val color = if (zone.direction == "BULLISH") Color(0xFF20D69A) else Color(0xFFFF647C)
                if (bottom > top && size.width > left) drawRect(color.copy(alpha = .10f), Offset(left, top), androidx.compose.ui.geometry.Size(size.width-left, bottom-top))
            }
        }
        smartMoney?.liquidityPools?.forEach { pool ->
            if (pool.price in priceLo..priceHi) {
                val yy = y(pool.price)
                val color = if (pool.type == "BUY_SIDE") Color(0xFFFFB74D) else Color(0xFF4DD0E1)
                drawLine(color.copy(alpha = if(pool.swept) .95f else .45f), Offset(0f, yy), Offset(size.width, yy), if(pool.swept) 1.8f else 1f)
            }
        }
        priceAction?.fibonacci?.forEach { level ->
            if(level.price in priceLo..priceHi) {
                val yy=y(level.price)
                drawLine(Color(0xFFB388FF).copy(alpha=.62f),Offset(0f,yy),Offset(size.width,yy),1f)
            }
        }
        val closes=data.map{it.close}
        fun drawLineSeries(values:List<Double>,color:Color,width:Float=1.8f){if(values.size<2)return;val path=Path();values.forEachIndexed{i,v->val x=step*(i+.5f);if(i==0)path.moveTo(x,y(v))else path.lineTo(x,y(v))};drawPath(path,color= color,style=androidx.compose.ui.graphics.drawscope.Stroke(width=width))}
        if(layers.ema9)drawLineSeries(emaSeries(closes,9),Color(0xFFFFD166),1.8f)
        if(layers.ema21)drawLineSeries(emaSeries(closes,21),Color(0xFF4DD0E1),1.8f)
        if(layers.ema50)drawLineSeries(emaSeries(closes,50),Color(0xFFB388FF),1.8f)
        if(layers.ema200)drawLineSeries(emaSeries(closes,200),Color(0xFFFF8A65),2f)
        if(layers.bands && closes.size>=20){val mid=closes.indices.map{i->if(i<19)closes.take(i+1).average() else closes.subList(i-19,i+1).average()};val upper=mid.indices.map{i->val part=closes.subList((i-19).coerceAtLeast(0),i+1);val avg=part.average();avg+2*kotlin.math.sqrt(part.map{(it-avg)*(it-avg)}.average())};val lower=mid.indices.map{i->val part=closes.subList((i-19).coerceAtLeast(0),i+1);val avg=part.average();avg-2*kotlin.math.sqrt(part.map{(it-avg)*(it-avg)}.average())};drawLineSeries(upper,Color(0xFF78909C),1f);drawLineSeries(lower,Color(0xFF78909C),1f)}
        if(layers.vwap){var pv=0.0;var vol=0.0;val series=data.map{v->val typical=(v.high+v.low+v.close)/3.0;pv+=typical*v.volume;vol+=v.volume;(pv/vol.coerceAtLeast(1e-12))};drawLineSeries(series,Color(0xFFFFFFFF),1.5f)}
        val lastPrice=data.last().close;val lastY=y(lastPrice);drawLine(Cyan.copy(alpha=.75f),Offset(0f,lastY),Offset(size.width,lastY),1.2f)
    }
}
