@Composable fun Metric(label:String,value:String){Column{Text(label,color=Muted,fontSize=10.sp);Text(value,color=Color.White,fontSize=12.sp,fontWeight=FontWeight.SemiBold)}}
private fun emaSeries(values:List<Double>,period:Int):List<Double>{
    if(values.isEmpty())return emptyList();val alpha=2.0/(period+1.0);var e=values.first()
    return values.mapIndexed{i,v->if(i==0)e=v else e=alpha*v+(1-alpha)*e;e}
}
