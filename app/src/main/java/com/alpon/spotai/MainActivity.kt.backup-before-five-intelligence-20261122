private fun relativeNewsTime(timestamp: Long): String {
    val minutes=((System.currentTimeMillis()-timestamp).coerceAtLeast(0L)/60_000L)
    return when { minutes<1 -> "Just now"; minutes<60 -> "${minutes}m ago"; minutes<1440 -> "${minutes/60}h ago"; else -> "${minutes/1440}d ago" }
}

