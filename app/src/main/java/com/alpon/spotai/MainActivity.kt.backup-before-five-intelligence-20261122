        if(page==null) NavigationBar(containerColor=Panel,contentColor=Muted,modifier=Modifier.heightIn(min=62.dp)) {
            nav.forEach{(name,icon)->val label=tr(name,language);NavigationBarItem(selected=tab==name,onClick={tab=name;if(name=="Markets")vm.loadMarkets()},icon={Icon(icon,null)},label={Text(label,fontSize=10.sp,maxLines=1)},colors=NavigationBarItemDefaults.colors(selectedIconColor=Cyan,selectedTextColor=Cyan,indicatorColor=Blue.copy(alpha=.14f),unselectedIconColor=Muted,unselectedTextColor=Muted))}
