    private fun updateAiAnalysis() {
        marketRegime = MarketRegimeAnalysis.analyze(candles)
        smartMoneyReport = SmartMoneyAnalysis.analyze(candles, marketStructure)
        val base = AIAnalysisEngine.analyze(
            signal, multiTimeframeSignal, marketStructure, marketRegime, priceActionReport, smartMoneyReport
        ) ?: run { aiAnalysisReport = null; return }
        val learning = AdaptiveLearningEngine.evaluate(
            marketRegime?.regime ?: "UNKNOWN",
            AdaptiveLearningEngine.decode(paperPrefs.getString("adaptive_outcomes", null))
        )
        aiAnalysisReport = if (base.action == "BUY" && !learning.allowed) {
            val previousGate = base.qualityGate
            val gate = previousGate?.copy(
                allowed = false,
                action = "WAIT",
                blockers = previousGate.blockers + learning.explanation
            )
            base.copy(action = "WAIT", warnings = base.warnings + learning.explanation, qualityGate = gate)
        } else if (base.action == "BUY" && learning.riskMultiplier < 1.0) {
            base.copy(warnings = base.warnings + learning.explanation)
        } else {
            base.copy(warnings = base.warnings + learning.explanation)
        }
    }

    fun runBacktest(initialCapital: Double = 1000.0, riskPercent: Double = 0.5) {
        if (backtestLoading) return
        val requestedSymbol = symbol
        val requestedInterval = interval

        viewModelScope.launch {
            backtestLoading = true
            backtestError = null
            backtestResult = null
            try {
                val historyInfo = withContext(Dispatchers.IO) {
                    Pair(
                        candleDao.getEarliestTime(requestedSymbol, requestedInterval),
                        candleDao.countCandles(requestedSymbol, requestedInterval)
                    )
                }
                val firstTime = historyInfo.first
                val storedCount = historyInfo.second

                if (firstTime == null || storedCount < 211) {
                    if (requestedSymbol == symbol && requestedInterval == interval) {
                        backtestError = "Not enough saved candles. Download Binance history for this coin and timeframe first."
                    }
                    return@launch
                }

                // Room pages are streamed directly into the engine. The full history is never
                // collected into an ArrayList, so RAM usage stays bounded as history grows.
                val result = withContext(Dispatchers.Default) {
                    BacktestingEngine.runFromPages(
                        firstTime = firstTime,
                        interval = requestedInterval,
                        initialCapital = initialCapital,
                        riskPercent = riskPercent
                    ) { afterTime, limit ->
                        candleDao.getCandlesAfter(
                            requestedSymbol,
                            requestedInterval,
                            afterTime,
                            limit
                        ).map { it.toCandle() }
                    }
                }

                if (requestedSymbol == symbol && requestedInterval == interval) {
                    backtestResult = result
                    if (result == null) {
                        backtestError = "Not enough valid Binance candle history for backtesting."
                    }
                }
            } catch (e: Exception) {
                if (requestedSymbol == symbol && requestedInterval == interval) {
                    backtestError = e.message ?: "Backtesting failed."
                }
            } finally {
                backtestLoading = false
            }
        }
    }

    fun runWalkForward(initialCapital: Double = 1000.0, riskPercent: Double = 0.5) {
        if (walkForwardLoading) return
        val requestedSymbol = symbol
        val requestedInterval = interval
        viewModelScope.launch {
            walkForwardLoading = true
            walkForwardError = null
            walkForwardResult = null
            try {
                val bounds = withContext(Dispatchers.IO) {
                    Pair(
                        candleDao.getEarliestTime(requestedSymbol, requestedInterval),
                        candleDao.getLatestTime(requestedSymbol, requestedInterval)
                    )
                }
                val first = bounds.first
                val last = bounds.second
                if (first == null || last == null || last <= first) {
                    if (requestedSymbol == symbol && requestedInterval == interval) {
                        walkForwardError = "Not enough saved history. Download more Binance candles first."
                    }
                    return@launch
                }

                val result = withContext(Dispatchers.Default) {
                    WalkForwardEngine.run(
                        firstTime = first,
                        lastTime = last,
                        interval = requestedInterval,
                        initialCapital = initialCapital,
                        riskPercent = riskPercent
                    ) { afterTime, untilTime, limit ->
                        candleDao.getCandlesAfterUntil(
                            requestedSymbol, requestedInterval, afterTime, untilTime, limit
                        ).map { it.toCandle() }
                    }
                }
                if (requestedSymbol == symbol && requestedInterval == interval) {
                    walkForwardResult = result
                    if (result == null) walkForwardError = "History is too short for chronological walk-forward testing."
                }
            } catch (e: Exception) {
                if (requestedSymbol == symbol && requestedInterval == interval) {
                    walkForwardError = e.message ?: "Walk-forward validation failed."
                }
            } finally {
                walkForwardLoading = false
            }
        }
    }

